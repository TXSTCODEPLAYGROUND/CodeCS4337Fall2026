{
  "seed": 42,
  "device": null,
  "wandb": {
    "project": "YoloExample"
  },
  "data": {
    "split_sizes": [120, 25, 25],
    "imgsz": 640,
    "batch": 16,
    "workers": 2
  },
  "model": {
    "weights": "yolov8n.pt"
  },
  "training": {
    "train": true,
    "epochs": 50,
    "patience": 15,
    "optimizer": "SGD",
    "lr0": 0.001,
    "ultralytics_args": {
      "freeze": 10
    }
  },
  "evaluation": {
    "conf": 0.001,
    "iou": 0.7,
    "gallery_conf": 0.25
  }
}
