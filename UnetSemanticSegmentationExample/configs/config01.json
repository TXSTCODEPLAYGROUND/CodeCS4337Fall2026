{
  "seed": 42,
  "accelerator": "auto",
  "wandb": {
    "project": "UnetSemanticSegmentationExample"
  },
  "data": {
    "image_size": 256,
    "batch_size": 16,
    "num_workers": 2,
    "augmentation": "minimal",
    "split_sizes": [800, 100, 100]
  },
  "model": {
    "architecture": "unet",
    "base_channels": 32,
    "depth": 4,
    "pretrained": false
  },
  "training": {
    "epochs": 100,
    "loss": "bce",
    "optimizer": "adam",
    "lr": 0.001,
    "encoder_lr": null,
    "weight_decay": 0.0,
    "scheduler": "none",
    "freeze_encoder_epochs": 0,
    "threshold": 0.5,
    "precision": "16-mixed",
    "early_stopping": true,
    "patience": 15
  }
}
