# Patterns without a leading slash match at any depth, so they cover every project.
.venv/
.venv-docs/
__pycache__/
.ruff_cache/
.vscode/

# Generated Sphinx HTML (docs/requirements.txt is enough to rebuild it).
docs/_build/

# Local environment. .envcolab stays tracked (renamed to .env in Colab).
.env

# Datasets (./data) and experiment outputs (./runs/<Project>/), shared by all projects.
data/
runs/

# W&B writes here only when run outside a project (each run keeps its own in runs/).
wandb/

# Ultralytics' weights_dir defaults to <repo>/weights (yolo26n.pt for its AMP check).
/weights/
