# Google Colab environment.
# In Colab, rename this file to .env (replacing the local one) so main()
# picks it up automatically. From the repo root (%cd CodeCS4337Fall2026):
#   !mv TrainingBasicConvnet/.envcolab TrainingBasicConvnet/.env
# Dataset lives on the fast local VM disk (re-downloaded each session).
# Outputs go to Google Drive so they survive runtime resets; requires
#   from google.colab import drive; drive.mount("/content/drive")
# Relative paths here are resolved against the TrainingBasicConvnet folder.
DATA_DIR=/content/data
OUTPUT_DIR=/content/drive/MyDrive/CodeCS4337Fall2026/TrainingBasicConvnet/runs
