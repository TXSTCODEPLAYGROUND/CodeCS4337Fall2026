{
  "seed": 42,
  "accelerator": "auto",
  "wandb": {
    "project": "LitWBHSTrainingBasicNeuralNetwork"
  },
  "data": {
    "batch_size": 256,
    "val_split": 0.1,
    "num_workers": 2
  },
  "model": {
    "hidden_sizes": [256, 128],
    "activation": "relu",
    "dropout": 0.2
  },
  "training": {
    "epochs": 10,
    "optimizer": "adam",
    "lr": 0.001,
    "momentum": 0.9,
    "l1": 0.0,
    "l2": 0.0,
    "scheduler": "none",
    "step_size": 3,
    "gamma": 0.5,
    "early_stopping": false,
    "patience": 3
  }
}
